@model IEnumerable<sistema_gastronomico_pascual_leyes_delahoz_clavero.Models.Pedido>

@{
    ViewData["Title"] = "Pedidos";
    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-receipt"></i> Pedidos</h2>
        <a asp-action="Alta" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Nuevo Pedido
        </a>
    </div>

    <partial name="_Mensajes" />

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>#ID</th>
                    <th>Fecha</th>
                    <th>Mesa</th>
                    <th>Empleado</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.IdPedido</td>
                            <td>@item.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>Mesa @item.Mesa?.Numero</td>
                            <td>@item.Empleado?.Apellido, @item.Empleado?.Nombre</td>
                            <td>$@item.Total.ToString("N2")</td>
                            <td><partial name="_EstadoBadge" model="item.estado" /></td>
                            <td class="text-center">
                                <a asp-action="Detalle" asp-route-id="@item.IdPedido" class="btn btn-sm btn-outline-primary" title="Ver detalle">
                                    <i class="bi bi-eye"></i> Ver
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            <em>No hay pedidos cargados en el sistema.</em>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPaginas > 1)
    {
        <nav class="mt-3">
            <ul class="pagination justify-content-center">
                <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual - 1)">Anterior</a>
                </li>
                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == paginaActual ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@i">@i</a>
                    </li>
                }
                <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual + 1)">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</div>
