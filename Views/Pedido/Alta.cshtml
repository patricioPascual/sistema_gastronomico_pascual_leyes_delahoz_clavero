@model sistema_gastronomico_pascual_leyes_delahoz_clavero.Models.Pedido
@using sistema_gastronomico_pascual_leyes_delahoz_clavero.Models

@{
    ViewData["Title"] = "Nuevo Pedido";
    var mesas = ViewBag.Mesas as IEnumerable<Mesa> ?? new List<Mesa>();
    var empleados = ViewBag.Empleados as IEnumerable<Empleado> ?? new List<Empleado>();
    var detallesJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Detalles.Select(d => new
        {
            idPlato = d.IdPlato,
            cantidad = d.Cantidad
        }));
}

<div class="container mt-4 mb-5" id="appPedido">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-receipt me-2"></i>Nuevo Pedido</h4>
        </div>
        <div class="card-body p-4">
            <partial name="_Mensajes" />

            <form asp-action="Alta" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="IdMesa" class="form-label fw-bold">Mesa</label>
                        <select asp-for="IdMesa" class="form-select" required>
                            <option value="">Seleccione una mesa...</option>
                            @foreach (var m in mesas)
                            {
                                <option value="@m.IdMesa">
                                    @(m.Tipo == "Barra" ? "Barra" : "Mesa") @m.Numero (@m.Capacidad personas)
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="IdEmpleado" class="form-label fw-bold">Empleado</label>
                        <select asp-for="IdEmpleado" class="form-select" required>
                            <option value="">Seleccione un empleado...</option>
                            @foreach (var e in empleados)
                            {
                                <option value="@e.IdEmpleado">@e.Apellido, @e.Nombre</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="text-primary mb-0"><i class="bi bi-egg-fried me-2"></i>Platos</h5>
                    <button type="button" class="btn btn-outline-success btn-sm" @@click="agregarRenglon">
                        <i class="bi bi-plus-lg"></i> Agregar Plato
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Plato</th>
                                <th style="width: 15%;">Cantidad</th>
                                <th style="width: 20%;">Precio ($)</th>
                                <th style="width: 20%;">Subtotal ($)</th>
                                <th style="width: 10%;" class="text-center">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr v-for="(item, index) in detalles" :key="item.uid">
                                <td>
                                    <select :data-uid="item.uid" :name="`Detalles[${index}].IdPlato`"
                                            class="form-select plato-ajax" required>
                                        <option value="" disabled selected hidden>Seleccione un plato...</option>
                                    </select>
                                </td>
                                <td>
                                    <input type="number" min="1" :name="`Detalles[${index}].Cantidad`"
                                           v-model.number="item.cantidad" class="form-control" required />
                                </td>
                                <td>{{ (item.precio || 0).toFixed(2) }}</td>
                                <td>{{ ((item.precio || 0) * (item.cantidad || 0)).toFixed(2) }}</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                        @@click="eliminarRenglon(index)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end fw-bold fs-5">Total:</td>
                                <td colspan="2" class="fw-bold fs-5 text-success">$ {{ total.toFixed(2) }}</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
                    <button type="submit" class="btn btn-primary">Guardar Pedido</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

    <script>
        const { createApp } = Vue;
        let nextUid = 1;

        const app = createApp({
            data() {
                const detallesIniciales = @Html.Raw(detallesJson);
                return {
                    detalles: detallesIniciales.length
                        ? detallesIniciales.map(d => ({
                            uid: nextUid++,
                            idPlato: d.idPlato || '',
                            precio: 0,
                            cantidad: d.cantidad || 1,
                        }))
                        : [],
                };
            },
            computed: {
                total() {
                    return this.detalles.reduce(
                        (sum, item) => sum + (item.precio || 0) * (item.cantidad || 0),
                        0
                    );
                },
            },
            methods: {
                agregarRenglon() {
                    this.detalles.push({ uid: nextUid++, idPlato: '', precio: 0, cantidad: 1 });
                    this.$nextTick(() => this.inicializarSelect2Pendientes());
                },
                eliminarRenglon(index) {
                    const item = this.detalles[index];
                    const $select = $(`select[data-uid="${item.uid}"]`);
                    if ($select.data('select2')) {
                        $select.select2('destroy');
                    }
                    this.detalles.splice(index, 1);
                },
                seleccionarPlato(uid, data) {
                    const item = this.detalles.find(d => d.uid === uid);
                    if (!item) return;
                    item.idPlato = data.id;
                    item.precio = data.precioCosto ?? 0;
                },
                inicializarSelect2Pendientes() {
                    $('.plato-ajax').each((_, el) => {
                        const $el = $(el);
                        if ($el.data('select2')) return;

                        $el.select2({
                            theme: 'bootstrap-5',
                            placeholder: 'Escriba para buscar un plato...',
                            minimumInputLength: 2,
                            ajax: {
                                url: '@Url.Action("BuscarPlato", "Plato")',
                                dataType: 'json',
                                delay: 300,
                                data: (params) => ({ q: params.term }),
                                processResults: (data) => ({
                                    results: data.map(p => ({
                                        id: p.id,
                                        text: p.texto,
                                        precioCosto: p.precioCosto,
                                    })),
                                }),
                                cache: true,
                            },
                        });

                        const uid = Number($el.data('uid'));

                        $el.on('select2:select', (e) => {
                            this.seleccionarPlato(uid, e.params.data);
                        });

                        $el.on('select2:clear', () => {
                            this.seleccionarPlato(uid, { id: '', texto: '', precioCosto: 0 });
                        });
                    });
                },
            },
            mounted() {
                if (this.detalles.length === 0) this.agregarRenglon();
                this.$nextTick(() => this.inicializarSelect2Pendientes());
            },
        }).mount('#appPedido');
    </script>
}
