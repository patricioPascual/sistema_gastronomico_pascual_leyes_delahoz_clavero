@using sistema_gastronomico_pascual_leyes_delahoz_clavero.Models
@{
    Layout = "_Layout"; 
    ViewData["Title"] = "Terminal de Salón";
}

<div id="app-salon" class="container-fluid py-3" v-cloak>

    <!-- CABECERA DE LA SPA -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold text-dark"><i class="bi bi-grid-3x3-gap me-2"></i>Salón</h2>
        <div>
            <button class="btn btn-outline-primary position-relative shadow-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasPendientes">
                <i class="bi bi-clock-history me-1"></i> Pedidos pendientes
                <span v-if="pendientes.length > 0" class="badge rounded-pill bg-danger position-absolute top-0 start-100 translate-middle">
                    {{ pendientes.length }}
                </span>
            </button>
        </div>
    </div>

    <!-- SECCIÓN MESAS -->
    <h5 class="text-secondary mb-3 fw-semibold">Mesas</h5>
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3 mb-4">
        <div class="col" v-for="m in mesas" :key="m.idMesa">
            <button type="button"
                    class="btn d-flex flex-column align-items-center justify-content-center text-white rounded-3 shadow-sm w-100 border-0 hover-elevate"
                    :class="m.idPedidoAbierto ? 'bg-danger' : 'bg-success'"
                    style="aspect-ratio: 1; font-size: 1.5rem; font-weight: 600;"
                    :title="'Mesa ' + m.numero + (m.idPedidoAbierto ? ' — Ocupada' : ' — Libre')"
                    @@click="abrirComanda(m, 'Mesa')">
                <span>{{ m.numero }}</span>
                <small class="fs-6 fw-normal text-white-50">{{ m.idPedidoAbierto ? 'Ocupada' : 'Libre' }}</small>
            </button>
        </div>
        <p v-if="mesas.length === 0" class="text-muted col-12">No hay mesas cargadas.</p>
    </div>

    <!-- SECCIÓN BARRA -->
    <h5 class="text-secondary mb-3 fw-semibold">Barra</h5>
    <div class="bg-light rounded-3 p-3 d-flex flex-wrap justify-content-start gap-3 mb-4 shadow-sm">
        <template v-for="b in barra" :key="b.idMesa">
            <button type="button"
                    class="btn d-flex align-items-center justify-content-center text-white rounded-circle shadow-sm border-0 hover-elevate"
                    :class="b.idPedidoAbierto ? 'bg-danger' : 'bg-success'"
                    style="width: 55px; height: 55px; font-weight: 600; font-size: 1.2rem;"
                    :title="'Barra ' + b.numero + (b.idPedidoAbierto ? ' — Ocupada' : ' — Libre')"
                    @@click="abrirComanda(b, 'Barra')">
                {{ b.numero }}
            </button>
        </template>
        <span v-if="barra.length === 0" class="text-muted">No hay posiciones de barra cargadas.</span>
    </div>

    <!-- OFFCANVAS: PEDIDOS PENDIENTES EN COCINA / MARCHA -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasPendientes" aria-labelledby="offcanvasPendientesLabel">
        <div class="offcanvas-header bg-dark text-white">
            <h5 class="offcanvas-title" id="offcanvasPendientesLabel"><i class="bi bi-clock-history me-2"></i>Pedidos pendientes</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
        </div>
        <div class="offcanvas-body">
            <p v-if="pendientes.length === 0" class="text-muted">No hay pedidos abiertos.</p>
            <ul v-else class="list-group">
                <li class="list-group-item shadow-sm mb-2 rounded border" v-for="p in pendientes" :key="p.idPedido">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold text-dark fs-6">Mesa {{ p.mesaNumero }}</span>
                        <span class="badge bg-secondary">
                            <span v-if="calcularMinutos(p.fechaHora) < 1">recién</span>
                            <span v-else>hace {{ calcularMinutos(p.fechaHora) }} min</span>
                        </span>
                    </div>
                    <small class="text-muted d-block mb-2"><i class="bi bi-person me-1"></i>{{ p.empleadoNombre }}</small>

                    <div class="list-group list-group-flush border-top pt-2">
                        <div v-for="d in p.detalles" :key="d.idDetallePedido" class="d-flex justify-content-between align-items-center py-1">
                            <div>
                                <span class="badge bg-primary me-1">{{ d.cantidad }}x</span>
                                <span class="small">{{ d.nombrePlato }}</span>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-success border-0 px-2 py-0" title="Despachar este plato"
                                    @@click="despacharDetalle(d.idDetallePedido, p.idPedido)">
                                <i class="bi bi-check-circle-fill fs-5"></i>
                            </button>
                        </div>
                    </div>
                </li>
            </ul>
        </div>
    </div>

    <!-- VISTA PARCIAL DEL MODAL (Modularizado) -->
    <partial name="modalMesa" />

</div>
@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    mesas: [],
                    barra: [],
                    pendientes: [],
                    menu: [],
                    comanda: [],
                    posicionSeleccionada: null,
                    tipoPosicion: '',
                    ahora: Date.now(),
                    cargandoMenu: false,
                    enviandoPedido: false,
                    mensajeError: '',
                    modalInstance: null,
                    categoriaActiva: 'Todas'
                }
            },
           computed: {
    // 1. Extrae dinámicamente las categorías únicas para las pestañas
    categorias() {
        if (!this.menu || this.menu.length === 0) return ['Todas'];
        return ['Todas', ...new Set(this.menu.map(p => p.categoria))];
    },
    // 2. Filtra los platos según la pestaña seleccionada
    platosFiltrados() {
        if (this.categoriaActiva === 'Todas') return this.menu;
        return this.menu.filter(p => p.categoria === this.categoriaActiva);
    }
},
            methods: {
                //  Obtener estado del salon vía API
                async cargarDatos() {
                    try {
                        const res = await fetch('/api/salon/estado-salon');
                        if (res.ok) {
                            const datos = await res.json();
                            this.mesas = datos.mesas;
                            this.barra = datos.barra;
                            this.pendientes = datos.pendientes;
                        }
                    } catch (e) {
                        console.error("Error al cargar datos del salón:", e);
                    }
                },

                //  CArGAR MENU VIA API
                async cargarMenu() {
                    if (this.menu.length > 0) return;
                    this.cargandoMenu = true;
                    try {
                        const res = await fetch('/api/plato');
                        if (res.ok) {
                            this.menu = await res.json();
                        }
                    } catch (e) {
                        console.error("Error al cargar platos:", e);
                    } finally {
                        this.cargandoMenu = false;
                    }
                },

                // ABRIR MODAL 
                abrirComanda(posicion, tipo) {
                    this.posicionSeleccionada = posicion;
                    this.tipoPosicion = tipo;
                    this.comanda = [];
                    this.mensajeError = '';

                    this.cargarMenu();

                    if (!this.modalInstance) {
                        const modalEl = document.getElementById('modalMesa');
                        if (modalEl) {
                            this.modalInstance = new bootstrap.Modal(modalEl);
                        }
                    }
                    if (this.modalInstance) {
                        this.modalInstance.show();
                    }
                },

                // AGREGAR PLATOS
                agregarAlCarrito(plato) {
                    this.mensajeError = '';
                    const precioVal = plato.precioVenta ?? plato.precio ?? 0;
                    const existe = this.comanda.find(item => item.idPlato === plato.idPlato);
                    
                    if (existe) {
                        existe.cantidad++;
                    } else {
                        this.comanda.push({
                            idPlato: plato.idPlato,
                            nombre: plato.nombre,
                            precioVenta: precioVal,
                            cantidad: 1
                        });
                    }
                },
                incrementarCantidad(idx) {
                    this.mensajeError = '';
                    this.comanda[idx].cantidad++;
                },
                decrementarCantidad(idx) {
                    this.mensajeError = '';
                    if (this.comanda[idx].cantidad > 1) {
                        this.comanda[idx].cantidad--;
                    } else {
                        this.comanda.splice(idx, 1);
                    }
                },
                calcularTotal() {
                    return this.comanda.reduce((sum, item) => sum + ((item.precioVenta ?? item.precio ?? 0) * item.cantidad), 0);
                },

                // AMNDAR PEDIDO
                async enviarComanda() {
                    this.enviandoPedido = true;
                    this.mensajeError = '';

                    const payload = {
                        idMesa: this.posicionSeleccionada.idMesa,
                        detalles: this.comanda.map(item => ({
                            idPlato: item.idPlato,
                            cantidad: item.cantidad
                        }))
                    };

                    try {
                        const res = await fetch('/api/pedidos/alta', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });

                        const data = await res.json();

                        if (res.ok) {
                            if (this.modalInstance) this.modalInstance.hide();
                            await this.cargarDatos();
                        } else {
                            this.mensajeError = data.mensaje || 'No se pudo guardar la comanda.';
                        }
                    } catch (e) {
                        this.mensajeError = 'Error de conexión con la API.';
                    } finally {
                        this.enviandoPedido = false;
                    }
                },

                // DESPACHAR PLATO
                async despacharDetalle(idDetallePedido, idPedido) {
                    try {
                        const res = await fetch('/Pedido/DespacharPedido', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: new URLSearchParams({ idDetallePedido, idPedido })
                        });

                        if (res.ok) {
                            await this.cargarDatos();
                        } else {
                            alert('No se pudo despachar el plato.');
                        }
                    } catch (e) {
                        console.error("Error al despachar:", e);
                    }
                },

                // 7. Acciones directas de la Mesa (Pagar/Cerrar y Liberar)
                async cerrarMesa(idPedido) {
                    if (!confirm('¿Confirmar cobro y cerrar este pedido?')) return;
                    try {
                        const res = await fetch('/Pedido/CerrarMesa', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: new URLSearchParams({ idPedido })
                        });
                        if (res.ok) {
                            if (this.modalInstance) this.modalInstance.hide();
                            await this.cargarDatos();
                        }
                    } catch (e) {
                        console.error("Error al cerrar mesa:", e);
                    }
                },
                async liberarMesa(idMesa) {
                    if (!confirm('¿Liberar la mesa? Quedará disponible para un nuevo pedido.')) return;
                    try {
                        const res = await fetch('/Pedido/LiberarMesa', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: new URLSearchParams({ idMesa })
                        });
                        if (res.ok) {
                            if (this.modalInstance) this.modalInstance.hide();
                            await this.cargarDatos();
                        }
                    } catch (e) {
                        console.error("Error al liberar mesa:", e);
                    }
                },

                // 8. Auxiliares visuales e íconos
                obtenerIconoCategoria(categoria) {
                    const iconos = {
                        'Todas': 'bi-grid-fill',
                        'Entrada': 'bi-egg-fried',
                        'Plato Principal': 'bi-fork-knife',                     
                        'Bebidas': 'bi-cup-straw',
                        'Postres': 'bi-cake',
                        
                    };
                    return iconos[categoria] || 'bi-tag';
                },
                calcularMinutos(fechaString) {
                    if (!fechaString) return 0;
                    const inicio = new Date(fechaString).getTime();
                    const minutos = Math.floor((this.ahora - inicio) / 60000);
                    return Math.max(0, minutos);
                }
            },
            mounted() {
                this.cargarDatos();

                setInterval(() => {
                    this.ahora = Date.now();
                    this.cargarDatos();
                }, 10000);
            }
        }).mount('#app-salon');
    </script>

    <style>
        .cursor-pointer { cursor: pointer; }
        .hover-elevate { transition: transform 0.15s ease-in-out, box-shadow 0.15s ease-in-out; }
        .hover-elevate:hover { transform: translateY(-3px); box-shadow: 0 .4rem .8rem rgba(0,0,0,.15)!important; }
        .fs-7 { font-size: 0.85rem; }
    </style>
}