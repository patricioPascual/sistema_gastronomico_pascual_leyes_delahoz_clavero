@using sistema_gastronomico_pascual_leyes_delahoz_clavero.Models
@{
    Layout = "_LayoutSPA";
    ViewData["Title"] = "Terminal de Salón";
}

<div id="app-salon" class="container-fluid py-3" v-cloak>

    <!-- Mensaje de error "global" -->
    <div v-if="mensajeGlobal" class="alert alert-danger alert-dismissible shadow-sm position-fixed top-0 start-50 translate-middle-x mt-3"
         style="z-index: 2000; min-width: 320px;">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> {{ mensajeGlobal }}
        <button type="button" class="btn-close" @@click="mensajeGlobal = ''"></button>
    </div>

    <!-- CABECERA DE LA SPA -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold text-dark"><i class="bi bi-grid-3x3-gap me-2"></i>Salón</h2>
        <div>
            <button class="btn btn-outline-primary position-relative shadow-sm" type="button" data-bs-toggle="offcanvas"
                    data-bs-target="#offcanvasPendientes">
                <i class="bi bi-clock-history me-1"></i> Pedidos pendientes
                <span v-if="pendientes.length > 0"
                      class="badge rounded-pill bg-danger position-absolute top-0 start-100 translate-middle">
                    {{ pendientes.length }}
                </span>
            </button>
        </div>
    </div>

    <!-- SECCIÓN MESAS -->
    <h5 class="text-secondary mb-3 fw-semibold">Mesas</h5>
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3 mb-4">
        <div class="col" v-for="m in mesas" :key="m.idMesa">
            <button type="button"
                    class="btn d-flex flex-column align-items-center justify-content-center text-white rounded-3 shadow-sm w-100 border-0 hover-elevate"
                    :class="m.idPedidoAbierto ? 'bg-danger' : 'bg-success'"
                    style="aspect-ratio: 1; font-size: 1.5rem; font-weight: 600;"
                    :title="'Mesa ' + m.numero + (m.idPedidoAbierto ? ' — Ocupada' : ' — Libre')"
                @@click="abrirComanda(m, 'Mesa')">
                <span>{{ m.numero }}</span>
                <small class="fs-6 fw-normal text-white-50">{{ m.idPedidoAbierto ? 'Ocupada' : 'Libre' }}</small>
            </button>
        </div>
        <p v-if="mesas.length === 0" class="text-muted col-12">No hay mesas cargadas.</p>
    </div>

    <!-- SECCIÓN BARRA -->
    <h5 class="text-secondary mb-3 fw-semibold">Barra</h5>
    <div class="bg-light rounded-3 p-3 d-flex flex-wrap justify-content-start gap-3 mb-4 shadow-sm">
        <template v-for="b in barra" :key="b.idMesa">
            <button type="button"
                    class="btn d-flex align-items-center justify-content-center text-white rounded-circle shadow-sm border-0 hover-elevate"
                    :class="b.idPedidoAbierto ? 'bg-danger' : 'bg-success'"
                    style="width: 55px; height: 55px; font-weight: 600; font-size: 1.2rem;"
                    :title="'Barra ' + b.numero + (b.idPedidoAbierto ? ' — Ocupada' : ' — Libre')"
                @@click="abrirComanda(b, 'Barra')">
                {{ b.numero }}
            </button>
        </template>
        <span v-if="barra.length === 0" class="text-muted">No hay posiciones de barra cargadas.</span>
    </div>

    <!-- OFFCANVAS: PEDIDOS PENDIENTES EN COCINA / MARCHA -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasPendientes"
         aria-labelledby="offcanvasPendientesLabel">
        <div class="offcanvas-header bg-dark text-white">
            <h5 class="offcanvas-title" id="offcanvasPendientesLabel"><i class="bi bi-clock-history me-2"></i>Pedidos
                pendientes</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"
                        aria-label="Cerrar"></button>
            </div>
            <div class="offcanvas-body">
                <p v-if="pendientes.length === 0" class="text-muted">No hay platos pendientes.</p>
                <ul v-else class="list-group">
                    <li class="list-group-item shadow-sm mb-2 rounded border" v-for="p in pendientes" :key="p.idPedido">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-dark fs-6">
                                Mesa {{ p.mesaNumero }}
                                <span v-if="p.cerrado" class="badge bg-success ms-1">Cobrado</span>
                            </span>
                            <span class="badge bg-secondary">
                                <span v-if="calcularMinutos(p.fechaHora) < 1">recién</span>
                                <span v-else>hace {{ calcularMinutos(p.fechaHora) }} min</span>
                            </span>
                        </div>
                        <small class="text-muted d-block mb-2"><i class="bi bi-person me-1"></i>{{ p.empleadoNombre }}</small>

                            <div class="list-group list-group-flush border-top pt-2">
                                <div v-for="d in p.detalles" :key="d.idDetallePedido"
                                     class="d-flex justify-content-between align-items-center py-1">
                                    <div>
                                        <span class="badge bg-primary me-1">{{ d.cantidad }}x</span>
                                        <span class="small">{{ d.nombrePlato }}</span>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-success border-0 px-2 py-0"
                                            title="Despachar este plato" @@click="despacharDetalle(d.idDetallePedido)">
                                        <i class="bi bi-check-circle-fill fs-5"></i>
                                    </button>
                                </div>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- VISTA PARCIAL DEL MODAL (Modularizado) -->
            <partial name="modalMesa" />
            <partial name="perfilModal" />

        </div>
        @section Scripts {
            <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
            <script>
                const TOKEN_API = '@ViewBag.TokenApi';
            </script>

            <script>
                const { createApp } = Vue;

                createApp({
                    data() {
                        return {
                            mesas: [],
                            barra: [],
                            pendientes: [],
                            menu: [],
                            comanda: [],
                            pedidoActual: null,          // pedido abierto de la mesa seleccionada (lo ya pedido)
                            posicionSeleccionada: null,
                            tipoPosicion: '',
                            ahora: Date.now(),
                            cargandoSalon: false,
                            cargandoMenu: false,
                            enviandoPedido: false,
                            mensajeError: '',
                            mensajeGlobal: '',
                            modalInstance: null,
                            categoriaActiva: 'Todas',
                            // Reemplaza al confirm() nativo: se muestra como banner dentro
                            // del modal en vez de un cartel del navegador (ver modalMesa.cshtml).
                            confirmando: { mensaje: '', accion: null }
                        }
                    },
                    computed: {
                        // Categorías únicas para las pestañas
                        categorias() {
                            if (!this.menu || this.menu.length === 0) return ['Todas'];
                            return ['Todas', ...new Set(this.menu.map(p => p.categoria))];
                        },
                        // Platos según la pestaña seleccionada
                        platosFiltrados() {
                            if (this.categoriaActiva === 'Todas') return this.menu;
                            return this.menu.filter(p => p.categoria === this.categoriaActiva);
                        },
                        // Total de la comanda que se está armando (todavía sin enviar)
                        totalComanda() {
                            return this.comanda.reduce((sum, item) => sum + (item.precioVenta * item.cantidad), 0);
                        }
                    },
                    methods: {
                        async api(url, opciones = {}) {
                            const headers = { ...(opciones.headers || {}), 'Authorization': 'Bearer ' + TOKEN_API };
                            const res = await fetch(url, { ...opciones, headers });

                            if (res.status === 401) {
                                // Token vencido: recargar la página emite uno nuevo si la cookie sigue vigente
                                // (y si no, el [Authorize] de la página manda al login).
                                if (!sessionStorage.getItem('spa401')) {
                                    sessionStorage.setItem('spa401', '1');
                                    window.location.reload();
                                }
                                return { ok: false, status: 401, data: { mensaje: 'Sesión inválida. Cerrá sesión y volvé a ingresar.' } };
                            }
                            if (res.status === 403) {
                                return { ok: false, status: 403, data: { mensaje: 'No tenés permiso para esta acción.' } };
                            }

                            sessionStorage.removeItem('spa401');

                            let data = null;
                            try { data = await res.json(); } catch (e) { /* respuesta sin cuerpo JSON */ }
                            return { ok: res.ok, status: res.status, data };
                        },
                        // Estado del salón vía API
                        async cargarDatos() {
                            if (this.cargandoSalon) return; // evita pedidos superpuestos si el servidor tarda más de 10 s
                            this.cargandoSalon = true;
                            try {
                                const r = await this.api('/api/salon/estado-salon');
                                if (r.ok && r.data) {
                                    this.mesas = r.data.mesas;
                                    this.barra = r.data.barra;
                                    this.pendientes = r.data.pendientes;

                                    // El modal guarda una referencia a la mesa: si no se la actualiza con los
                                    // datos nuevos, el estado Libre/Ocupada y el botón de cobro quedan viejos.
                                    if (this.posicionSeleccionada) {
                                        const actual = [...this.mesas, ...this.barra]
                                            .find(x => x.idMesa === this.posicionSeleccionada.idMesa);
                                        if (actual) this.posicionSeleccionada = actual;
                                    }
                                }
                            } catch (e) {
                                console.error("Error al cargar datos del salón:", e);
                            } finally {
                                this.cargandoSalon = false;
                            }
                        },

                        // Carta vía API. Se recarga cada vez que se abre una mesa (precios y platos activos
                        // pueden cambiar); el spinner solo se muestra la primera vez.
                        async cargarMenu() {
                            if (this.menu.length === 0) this.cargandoMenu = true;
                            try {
                                const r = await this.api('/api/plato');
                                if (r.ok && Array.isArray(r.data)) {
                                    this.menu = r.data;
                                } else if (this.menu.length === 0) {
                                    this.mensajeError = (r.data && r.data.mensaje) || 'No se pudo cargar la carta.';
                                }
                            } catch (e) {
                                console.error("Error al cargar platos:", e);
                                if (this.menu.length === 0) this.mensajeError = 'No se pudo cargar la carta.';
                            } finally {
                                this.cargandoMenu = false;
                            }
                        },

                        // Lo ya pedido en una mesa ocupada (platos, estado y total del pedido)
                        async cargarPedidoActual(idPedido) {
                            try {
                                const r = await this.api(`/api/pedidos/${idPedido}`);
                                if (r.ok) this.pedidoActual = r.data;
                            } catch (e) {
                                console.error("Error al cargar el pedido:", e);
                            }
                        },

                        // ABRIR MODAL
                        abrirComanda(posicion, tipo) {
                            this.posicionSeleccionada = posicion;
                            this.tipoPosicion = tipo;
                            this.comanda = [];
                            this.pedidoActual = null;
                            this.mensajeError = '';
                            this.categoriaActiva = 'Todas';
                            this.confirmando = { mensaje: '', accion: null };

                            this.cargarMenu();
                            if (posicion.idPedidoAbierto) this.cargarPedidoActual(posicion.idPedidoAbierto);

                            if (!this.modalInstance) {
                                const modalEl = document.getElementById('modalMesa');
                                if (modalEl) {
                                    this.modalInstance = new bootstrap.Modal(modalEl);
                                }
                            }
                            if (this.modalInstance) {
                                this.modalInstance.show();
                            }
                        },

                        // AGREGAR PLATOS
                        agregarAlCarrito(plato) {
                            this.mensajeError = '';
                            const precioVal = plato.precioVenta ?? plato.precio ?? 0;
                            const existe = this.comanda.find(item => item.idPlato === plato.idPlato);

                            if (existe) {
                                existe.cantidad++;
                            } else {
                                this.comanda.push({
                                    idPlato: plato.idPlato,
                                    nombre: plato.nombre,
                                    precioVenta: precioVal,
                                    cantidad: 1
                                });
                            }
                        },
                        incrementarCantidad(idx) {
                            this.mensajeError = '';
                            this.comanda[idx].cantidad++;
                        },
                        decrementarCantidad(idx) {
                            this.mensajeError = '';
                            if (this.comanda[idx].cantidad > 1) {
                                this.comanda[idx].cantidad--;
                            } else {
                                this.comanda.splice(idx, 1);
                            }
                        },

                        // MANDAR PEDIDO (mesa libre: crea el pedido; mesa ocupada: agrega al pedido abierto)
                        async enviarComanda() {
                            if (this.comanda.length === 0 || this.enviandoPedido) return;
                            this.enviandoPedido = true;
                            this.mensajeError = '';

                            const payload = {
                                idMesa: this.posicionSeleccionada.idMesa,
                                detalles: this.comanda.map(item => ({
                                    idPlato: item.idPlato,
                                    cantidad: item.cantidad
                                }))
                            };

                            try {
                                const r = await this.api('/api/pedidos/alta', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify(payload)
                                });

                                if (r.ok) {
                                    if (this.modalInstance) this.modalInstance.hide();
                                    await this.cargarDatos();
                                } else {
                                    this.mensajeError = (r.data && r.data.mensaje) || 'No se pudo guardar la comanda.';
                                }
                            } catch (e) {
                                this.mensajeError = 'Error de conexión con la API.';
                            } finally {
                                this.enviandoPedido = false;
                            }
                        },

                        pedirConfirmacion(mensaje, accion) {
                            this.confirmando = { mensaje, accion };
                        },
                        confirmarSi() {
                            const accion = this.confirmando.accion;
                            this.confirmando = { mensaje: '', accion: null };
                            if (accion) accion();
                        },

                        // MODIFICAR cantidad de un plato ya pedido 
                        async modificarCantidadPedido(detalle, nuevaCantidad) {
                            if (nuevaCantidad < 1) {
                                return this.eliminarDetallePedido(detalle.idDetallePedido);
                            }

                            this.mensajeError = '';
                            try {
                                const r = await this.api(`/api/pedidos/detalle/${detalle.idDetallePedido}`, {
                                    method: 'PUT',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ cantidad: nuevaCantidad })
                                });

                                if (r.ok) {
                                    await this.cargarDatos();
                                    if (this.pedidoActual) await this.cargarPedidoActual(this.pedidoActual.idPedido);
                                } else {
                                    this.mensajeError = (r.data && r.data.mensaje) || 'No se pudo modificar la cantidad.';
                                }
                            } catch (e) {
                                console.error("Error al modificar la cantidad:", e);
                                this.mensajeError = 'Error de conexión con la API.';
                            }
                        },

                        // QUITAR un plato del pedido (Baja de una línea, parte del ABM).
                        eliminarDetallePedido(idDetallePedido) {
                            this.pedirConfirmacion('¿Quitar este plato del pedido?',
                                () => this.ejecutarEliminarDetalle(idDetallePedido));
                        },
                        async ejecutarEliminarDetalle(idDetallePedido) {
                            this.mensajeError = '';
                            try {
                                const r = await this.api(`/api/pedidos/detalle/${idDetallePedido}`, { method: 'DELETE' });

                                if (r.ok) {
                                    await this.cargarDatos();
                                    if (this.pedidoActual) await this.cargarPedidoActual(this.pedidoActual.idPedido);
                                } else {
                                    this.mensajeError = (r.data && r.data.mensaje) || 'No se pudo quitar el plato.';
                                }
                            } catch (e) {
                                console.error("Error al quitar el plato:", e);
                                this.mensajeError = 'Error de conexión con la API.';
                            }
                        },

                        // CANCELAR pedido completo (Baja del ABM de Pedido).
                        cancelarPedido(idPedido) {
                            this.pedirConfirmacion('¿Cancelar este pedido? Esta acción no se puede deshacer.',
                                () => this.ejecutarCancelarPedido(idPedido));
                        },
                        async ejecutarCancelarPedido(idPedido) {
                            this.mensajeError = '';
                            try {
                                const r = await this.api(`/api/pedidos/${idPedido}`, { method: 'DELETE' });

                                if (r.ok) {
                                    if (this.modalInstance) this.modalInstance.hide();
                                    await this.cargarDatos();
                                } else {
                                    this.mensajeError = (r.data && r.data.mensaje) || 'No se pudo cancelar el pedido.';
                                }
                            } catch (e) {
                                console.error("Error al cancelar el pedido:", e);
                                this.mensajeError = 'Error de conexión con la API.';
                            }
                        },

                        // DESPACHAR PLATO 
                        async despacharDetalle(idDetallePedido) {
                            try {
                                const r = await this.api(`/api/pedidos/detalle/${idDetallePedido}/despachar`, { method: 'POST' });

                                if (r.ok) {
                                    await this.cargarDatos();
                                    if (this.pedidoActual) await this.cargarPedidoActual(this.pedidoActual.idPedido);
                                } else {
                                    this.mensajeGlobal = (r.data && r.data.mensaje) || 'No se pudo despachar el plato.';
                                }
                            } catch (e) {
                                console.error("Error al despachar:", e);
                                this.mensajeGlobal = 'Error de conexión con la API.';
                            }
                        },

                        // PAGAR Y CERRAR
                        cerrarMesa(idPedido) {
                            const aviso = this.comanda.length > 0
                                ? 'Hay platos en la comanda que todavía NO se enviaron y se van a descartar. '
                                : '';
                            this.pedirConfirmacion(aviso + '¿Confirmar cobro y cerrar este pedido?',
                                () => this.ejecutarCerrarMesa(idPedido));
                        },
                        async ejecutarCerrarMesa(idPedido) {
                            try {
                                const r = await this.api(`/api/pedidos/${idPedido}/cerrar`, { method: 'POST' });

                                if (r.ok) {
                                    if (this.modalInstance) this.modalInstance.hide();
                                    await this.cargarDatos();
                                } else {
                                    this.mensajeError = (r.data && r.data.mensaje) || 'No se pudo cerrar el pedido.';
                                }
                            } catch (e) {
                                console.error("Error al cerrar mesa:", e);
                                this.mensajeError = 'Error de conexión con la API.';
                            }
                        },

                        // LIBERAR MESA (pedido ya cobrado)
                        liberarMesa(idMesa) {
                            this.pedirConfirmacion('¿Liberar la mesa? Quedará disponible para un nuevo pedido.',
                                () => this.ejecutarLiberarMesa(idMesa));
                        },
                        async ejecutarLiberarMesa(idMesa) {
                            try {
                                const r = await this.api(`/api/pedidos/mesa/${idMesa}/liberar`, { method: 'POST' });

                                if (r.ok) {
                                    if (this.modalInstance) this.modalInstance.hide();
                                    await this.cargarDatos();
                                } else {
                                    this.mensajeError = (r.data && r.data.mensaje) || 'No se pudo liberar la mesa.';
                                }
                            } catch (e) {
                                console.error("Error al liberar mesa:", e);
                                this.mensajeError = 'Error de conexión con la API.';
                            }
                        },

                        // Auxiliares visuales e íconos
                        obtenerIconoCategoria(categoria) {
                            const iconos = {
                                'Todas': 'bi-grid-fill',
                                'Entrada': 'bi-egg-fried',
                                'Plato Principal': 'bi-fork-knife',
                                'Bebidas': 'bi-cup-straw',
                                'Postres': 'bi-cake'
                            };
                            return iconos[categoria] || 'bi-tag';
                        },
                        calcularMinutos(fechaString) {
                            if (!fechaString) return 0;
                            const inicio = new Date(fechaString).getTime();
                            const minutos = Math.floor((this.ahora - inicio) / 60000);
                            return Math.max(0, minutos);
                        }
                    },
                    mounted() {
                        this.cargarDatos();

                        setInterval(() => {
                            this.ahora = Date.now();
                            this.cargarDatos();
                        }, 10000);
                    }
                }).mount('#app-salon');
            </script>

            <style>
                .cursor-pointer {
                    cursor: pointer;
                }

                .hover-elevate {
                    transition: transform 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
                }

                .hover-elevate:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 .4rem .8rem rgba(0, 0, 0, .15) !important;
                }

                .fs-7 {
                    font-size: 0.85rem;
                }
            </style>
        }
