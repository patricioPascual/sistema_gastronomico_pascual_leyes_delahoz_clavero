@{
    var nombreCompleto = User.FindFirst("NombreCompleto")?.Value ?? User.Identity?.Name;
    var username = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value;
    
    var avatarModalVm = new sistema_gastronomico_pascual_leyes_delahoz_clavero.Models.AvatarViewModel
    {
        AvatarPath = User.FindFirst("AvatarPath")?.Value,
        Nombre = User.FindFirst("Nombre")?.Value,
        Apellido = User.FindFirst("Apellido")?.Value,
        Tamanio = 100
    };
}

<div class="modal fade" id="perfilModal" tabindex="-1" aria-labelledby="perfilModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body text-center pb-5 px-4">

                <div class="mb-3 d-flex justify-content-center">
                    <div class="shadow-sm rounded-circle d-flex align-items-center justify-content-center bg-white"
                         style="border: 4px solid #f8d7da; padding: 2px;">
                        <partial name="_Avatar" model="avatarModalVm" />
                    </div>
                </div>
                
                <h4 class="fw-bold mb-1">@nombreCompleto</h4>
                <p class="text-muted mb-4"><i class="bi bi-person-badge me-1"></i> Cuenta de Mozo</p>
                
                <div class="bg-light rounded-3 p-3 text-start">
                    <p class="mb-2 small text-muted text-uppercase fw-bold"><i class="bi bi-info-circle me-1"></i>
                        Información de Sesión</p>
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
                            <span class="fw-medium text-dark">Usuario:</span>
                            <span class="text-secondary">@@@username</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-medium text-dark">Nivel de Acceso:</span>
                            <span class="badge bg-danger rounded-pill">Punto de Venta (SPA)</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top-0 rounded-bottom-4 justify-content-between py-3 px-4">
                    <a href="/Usuario/Perfil" class="btn btn-outline-danger rounded-pill px-4 fw-bold">
                        <i class="bi bi-pencil-square me-1"></i> Editar Perfil
                    </a>
                    <button type="button" class="btn btn-secondary rounded-pill px-4 fw-bold" data-bs-dismiss="modal">
                        Volver
                    </button>
                </div>
            </div>
        </div>
    </div>