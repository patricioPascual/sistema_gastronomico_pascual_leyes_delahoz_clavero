@model IEnumerable<sistema_gastronomico_pascual_leyes_delahoz_clavero.Models.Proveedor>

@{
    bool inactivos = ViewBag.Inactivos ?? false;
    ViewData["Title"] = "Gestión de Proveedores";
}

<div class="container mt-4">
    
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-truck me-2"></i>@(inactivos ? "Proveedores Inactivos" : "Listado de Proveedores")</h2>
        <div>
            @if (inactivos)
            {
                <a asp-action="Index" class="btn btn-outline-secondary shadow-sm me-2">
                    <i class="bi bi-arrow-left me-1"></i> Ver activos
                </a>
            }
            else
            {
                <a asp-action="Index" asp-route-inactivos="true" class="btn btn-outline-secondary shadow-sm me-2">
                    <i class="bi bi-archive me-1"></i> Ver inactivos
                </a>
            }
            <a asp-action="Alta" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Agregar Proveedor
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>#ID</th>
                            <th>Razón Social / Nombre</th>
                            <th>CUIT</th>
                            <th>Teléfono</th>
                            <th>Dirección</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.IdProveedor</td>
                                    <td><strong>@item.Nombre</strong></td>
                                    <td>@(string.IsNullOrEmpty(item.Cuit) ? "-" : item.Cuit)</td>
                                    <td>@(string.IsNullOrEmpty(item.Telefono) ? "-" : item.Telefono)</td>
                                    <td>@(string.IsNullOrEmpty(item.Direccion) ? "-" : item.Direccion)</td>
                                    <td class="text-center">
                                        @if (inactivos)
                                        {
                                            <form asp-action="Reactivar" asp-route-id="@item.IdProveedor" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Reactivar proveedor">
                                                    <i class="bi bi-arrow-counterclockwise"></i> Reactivar
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <a asp-action="Editar" asp-route-id="@item.IdProveedor"
                                               class="btn btn-sm btn-outline-primary me-1" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-danger" title="Eliminar"
                                                    onclick="abrirModalEliminar(@item.IdProveedor, '@item.Nombre', '@Url.Action("Baja", "Proveedor")')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    <em>@(inactivos ? "No hay proveedores inactivos." : "No hay proveedores registrados en el sistema.")</em>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@if (ViewBag.TotalPaginas > 1)
{
    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;

    <nav aria-label="Navegación de páginas" class="mt-4">
        <ul class="pagination justify-content-center">
                
            <!-- Botón Anterior -->
            <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-inactivos="@inactivos" asp-route-pagina="@(paginaActual - 1)">
                    <i class="bi bi-chevron-left"></i> Anterior
                </a>
            </li>

            <!-- Números de Página -->
            @for (int i = 1; i <= totalPaginas; i++)
            {
                <li class="page-item @(i == paginaActual ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-inactivos="@inactivos" asp-route-pagina="@i">@i</a>
                </li>
            }

            <!-- Botón Siguiente -->
            <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-inactivos="@inactivos" asp-route-pagina="@(paginaActual + 1)">
                    Siguiente <i class="bi bi-chevron-right"></i>
                </a>
            </li>

        </ul>
    </nav>
}

<partial name="_ModalEliminar" />