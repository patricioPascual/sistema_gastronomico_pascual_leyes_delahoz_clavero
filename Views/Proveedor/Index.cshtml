@model IEnumerable<sistema_gastronomico_pascual_leyes_delahoz_clavero.Models.Proveedor>

@{
    ViewData["Title"] = "Gestión de Proveedores";
}

<div class="container mt-4">
    
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-truck me-2"></i>Listado de Proveedores</h2>
        <a asp-action="Alta" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Agregar Proveedor
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>#ID</th>
                            <th>Razón Social / Nombre</th>
                            <th>CUIT</th>
                            <th>Teléfono</th>
                            <th>Dirección</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.IdProveedor</td>
                                    <td><strong>@item.Nombre</strong></td>
                                    <td>@(string.IsNullOrEmpty(item.Cuit) ? "-" : item.Cuit)</td>
                                    <td>@(string.IsNullOrEmpty(item.Telefono) ? "-" : item.Telefono)</td>
                                    <td>@(string.IsNullOrEmpty(item.Direccion) ? "-" : item.Direccion)</td>
                                    <td class="text-center">
                                        <a asp-action="Editar" asp-route-id="@item.IdProveedor"
                                           class="btn btn-sm btn-outline-primary me-1" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Eliminar"
                                                onclick="abrirModalEliminar(@item.IdProveedor, '@item.Nombre', '@Url.Action("Baja", "Proveedor")')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    <em>No hay proveedores registrados en el sistema.</em>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<partial name="_ModalEliminar" />