@model IEnumerable<sistema_gastronomico_pascual_leyes_delahoz_clavero.Models.Plato>

@using sistema_gastronomico_pascual_leyes_delahoz_clavero.Models

@{
    ViewData["Title"] = "Menú Digital";

    var categorias = ViewBag.Categorias as IEnumerable<Categoria> ?? Enumerable.Empty<Categoria>();
    int? idCategoriaActiva = ViewBag.IdCategoria as int?;
    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;

    string Icono(string? categoria) => categoria switch
    {
        "Entrada" => "bi-egg-fried",
        "Plato Principal" => "bi-fork-knife",
        "Pizzas" => "bi-pie-chart",
        "Bebidas" => "bi-cup-straw",
        "Postres" => "bi-cake",
        "Cafetería" => "bi-cup-hot",
        _ => "bi-tag"
    };
}

<div class="container mt-4" id="appMenu">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-book-half me-2"></i> Carta / Menú</h2>
        <a asp-action="Crear" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-lg"></i> Agregar Nuevo Plato
        </a>
    </div>

    <ul class="nav nav-tabs nav-fill mb-4">
        <li class="nav-item">
            <a class="nav-link fw-bold @(idCategoriaActiva == null ? "active" : "")" asp-action="Index">
                <i class="bi bi-grid-fill me-2"></i> Todas
            </a>
        </li>
        @foreach (var cat in categorias)
        {
            <li class="nav-item">
                <a class="nav-link fw-bold @(idCategoriaActiva == cat.IdCategoria ? "active" : "")"
                   asp-action="Index" asp-route-idCategoria="@cat.IdCategoria">
                    <i class="bi @Icono(cat.Nombre) me-2"></i> @cat.Nombre
                </a>
            </li>
        }
    </ul>

    <div v-cloak class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">

        <div class="col" v-for="plato in platos" :key="plato.idPlato">
            <div class="card h-100 shadow-sm border-0" :class="{ 'opacity-50': !plato.estado }">

                <a :href="'/Plato/Detalle/' + plato.idPlato">
                    <img :src="'/img/platos/plato_' + plato.idPlato + '.jpg'"
                         onerror="this.onerror=null; this.src='/img/platos/default.svg';"
                         class="card-img-top object-fit-cover" style="height: 200px;" alt="Foto del plato">
                </a>

                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="card-title text-truncate mb-0" :title="plato.nombre">
                            <a :href="'/Plato/Detalle/' + plato.idPlato" class="text-decoration-none text-dark">{{
                                plato.nombre }}</a>
                            </h5>
                            <span v-if="!plato.estado" class="badge bg-secondary ms-2">Inactivo</span>
                        </div>

                        <h4 class="text-success fw-bold mt-auto">$ {{ plato.precioVenta.toFixed(2) }}</h4>
                    </div>

                    <div class="card-footer bg-white border-top-0 pb-3">
                        <div class="d-flex justify-content-between">
                            <a :href="'/Plato/Detalle/' + plato.idPlato" class="btn btn-outline-secondary btn-sm w-100 me-2"
                               title="Ver">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a :href="'/Plato/Editar/' + plato.idPlato" class="btn btn-outline-primary btn-sm w-100 me-2"
                               title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>

                            <button v-if="plato.estado" class="btn btn-outline-danger btn-sm"
                                @@click="confirmarBaja(plato)" title="Dar de baja">
                                <i class="bi bi-trash"></i>
                            </button>

                            <form v-else action="/Plato/Reactivar" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" :value="plato.idPlato" />
                                <button type="submit" class="btn btn-outline-success btn-sm" title="Reactivar plato">
                                    <i class="bi bi-arrow-counterclockwise"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div v-if="platos.length === 0" class="col-12 text-center py-5 text-muted">
                <i class="bi bi-search fs-1"></i>
                <p class="mt-2">No hay platos registrados en esta categoría.</p>
            </div>

        </div>

    @if (totalPaginas > 1)
    {
        <nav aria-label="Navegación de páginas" class="mt-4">
            <ul class="pagination justify-content-center flex-wrap">
                <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-idCategoria="@idCategoriaActiva"
                       asp-route-pagina="@(paginaActual - 1)">
                        <i class="bi bi-chevron-left"></i> Anterior
                    </a>
                </li>

                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == paginaActual ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-idCategoria="@idCategoriaActiva"
                           asp-route-pagina="@i">@i</a>
                    </li>
                }

                <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-idCategoria="@idCategoriaActiva"
                       asp-route-pagina="@(paginaActual + 1)">
                        Siguiente <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

<partial name="_ModalEliminar" />

    @section Scripts {
        <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

        <script>
            const datosPlatos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(p => new
                {
                    idPlato = p.IdPlato,
                    nombre = p.Nombre,
                    precioVenta = p.PrecioVenta,
                    estado = p.Estado
                })));

            const { createApp } = Vue;

            createApp({
                data() {
                    return {
                        platos: datosPlatos
                    };
                },
                methods: {
                    confirmarBaja(plato) {
                        abrirModalEliminar(plato.idPlato, plato.nombre, '/Plato/Eliminar');
                    }
                }
            }).mount('#appMenu');
        </script>
    }
