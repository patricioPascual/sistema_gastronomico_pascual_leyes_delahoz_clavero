@model sistema_gastronomico_pascual_leyes_delahoz_clavero.Models.PlatoFormViewModel

<div class="container mt-4">
    <h2><i class="bi bi-egg-fried"></i> @ViewData["Titulo"]</h2>

    <form asp-action="@ViewData["FormAction"]" method="post" class="mt-3">
        @if (Model.Plato.IdPlato > 0)
        {
            <input type="hidden" asp-for="Plato.IdPlato" />
        }
        <input type="hidden" asp-for="Plato.Estado" value="true" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Nombre</label>
                <input asp-for="Plato.Nombre" class="form-control" />
                <span asp-validation-for="Plato.Nombre" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label">Categoría</label>
                <select asp-for="Plato.IdCategoria" class="form-select">
                    <option value="">Seleccionar...</option>
                    @foreach (var c in Model.Categorias)
                    {
                        <option value="@c.IdCategoria">@c.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Precio de venta</label>
                <input asp-for="Plato.PrecioVenta" type="number" step="0.01" class="form-control" />
            </div>
        </div>

        <hr class="my-4" />

        <h4>Receta</h4>
        <p class="text-muted">Insumos y cantidades que componen el plato.</p>

        <div id="recetaApp">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Insumo</th>
                        <th style="width: 200px">Cantidad requerida</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <tr v-for="(linea, index) in receta" :key="index">
                        <td>
                            <select class="form-select" v-model.number="linea.idProducto" :name="`Receta[${index}].IdProducto`">
                                <option value="0" disabled>Seleccionar insumo...</option>
                                <option v-for="p in productos" :key="p.id" :value="p.id">
                                    {{ p.nombre }} ({{ p.unidad }})
                                </option>
                            </select>
                        </td>
                        <td>
                            <input type="number" step="0.01" min="0.01" class="form-control"
                                   v-model.number="linea.cantidadRequerida"
                                   :name="`Receta[${index}].CantidadRequerida`">
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-danger" @@click="quitarLinea(index)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
            <button type="button" class="btn btn-sm btn-outline-secondary" @@click="agregarLinea">
                <i class="bi bi-plus-lg"></i> Agregar insumo
            </button>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-check-lg"></i> Guardar
            </button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script>
        const recetaInicial = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Receta.Select(r => new { idProducto = r.IdProducto, cantidadRequerida = r.CantidadRequerida })
        ));
        const productosDisponibles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.ProductosDisponibles.Select(p => new { id = p.IdProducto, nombre = p.Nombre, unidad = p.Unidad_medida })
        ));

        Vue.createApp({
            data() {
                return {
                    receta: recetaInicial.length > 0 ? recetaInicial : [{ idProducto: 0, cantidadRequerida: 0 }],
                    productos: productosDisponibles
                };
            },
            methods: {
                agregarLinea() {
                    this.receta.push({ idProducto: 0, cantidadRequerida: 0 });
                },
                quitarLinea(index) {
                    this.receta.splice(index, 1);
                }
            }
        }).mount('#recetaApp');
    </script>
}
