@model sistema_gastronomico_pascual_leyes_delahoz_clavero.Models.PlatoFormViewModel

<div class="container mt-4">
    <h2><i class="bi bi-egg-fried"></i> @ViewData["Titulo"]</h2>

    <form asp-action="@ViewData["FormAction"]" method="post" class="mt-3">
        @if (Model.Plato.IdPlato > 0)
        {
            <input type="hidden" asp-for="Plato.IdPlato" />
        }
        <input type="hidden" asp-for="Plato.Estado" value="true" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Nombre</label>
                <input asp-for="Plato.Nombre" class="form-control" />
                <span asp-validation-for="Plato.Nombre" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label">Categoría</label>
                <select asp-for="Plato.IdCategoria" class="form-select">
                    <option value="">Seleccionar...</option>
                    @foreach (var c in Model.Categorias)
                    {
                        <option value="@c.IdCategoria">@c.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Precio de venta</label>
                <input asp-for="Plato.PrecioVenta" type="number" step="0.01" class="form-control" />
            </div>
        </div>

        <hr class="my-4" />

        <h4>Receta</h4>
        <p class="text-muted">Insumos y cantidades que componen el plato. Escribí al menos 2 letras para buscar un
            insumo.</p>

            <table class="table table-sm align-middle" id="tablaReceta">
                <thead>
                    <tr>
                        <th>Insumo</th>
                        <th style="width: 200px">Cantidad requerida</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <!-- plato-receta.js arma las filas acá -->
                </tbody>
            </table>
            <button type="button" id="btnAgregarInsumo" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-plus-lg"></i> Agregar insumo
            </button>

            <div class="mt-4">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-lg"></i> Guardar
                </button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>


