@model IEnumerable<sistema_gastronomico_pascual_leyes_delahoz_clavero.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios";

    var datosUsuariosJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Select(u => new
        {
            idUsuario = u.IdUsuario,
            legajo = u.Empleado != null ? u.Empleado.Legajo : "",
            nombreCompleto = u.Empleado != null ? $"{u.Empleado.Apellido}, {u.Empleado.Nombre}" : "",
            dni = u.Empleado != null ? u.Empleado.Dni : "",
            username = u.Username,
            rolNombre = u.Rol != null ? u.Rol.Nombre : "Sin rol",
            estado = u.Estado
        })
    );
}

<div class="container mt-4" id="appUsuarios">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people-fill"></i> Usuarios / Empleados</h2>
        <a asp-action="Registrar" class="btn btn-success shadow-sm">
            <i class="bi bi-person-plus"></i> Nuevo Usuario
        </a>
    </div>

    <ul class="nav nav-tabs nav-fill mb-4" role="tablist">
        <li class="nav-item" v-for="rol in roles" :key="rol">
            <button class="nav-link fw-bold" :class="{ 'active': rolActivo === rol }" @@click="cambiarRol(rol)">
                {{ rol }}
            </button>
        </li>
    </ul>

    <div v-cloak class="table-responsive shadow-sm rounded">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Legajo</th>
                    <th>Nombre</th>
                    <th>DNI</th>
                    <th>Usuario</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <tr v-for="u in usuariosFiltrados" :key="u.idUsuario">
                    <td>{{ u.legajo }}</td>
                    <td><strong>{{ u.nombreCompleto }}</strong></td>
                    <td>{{ u.dni }}</td>
                    <td>{{ u.username }}</td>
                    <td>{{ u.rolNombre }}</td>
                    <td>
                        <span class="badge" :class="u.estado ? 'bg-success' : 'bg-secondary'">
                            {{ u.estado ? 'Activo' : 'Inactivo' }}
                        </span>
                    </td>
                    <td class="text-center">
                        <a :href="'/Usuario/Editar/' + u.idUsuario" class="btn btn-sm btn-outline-primary me-1" title="Editar">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-danger" title="Dar de baja"
                                :disabled="!u.estado"
                                @@click="confirmarBaja(u)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
                <tr v-if="usuariosFiltrados.length === 0">
                    <td colspan="7" class="text-center text-muted py-4">
                        <em>No hay usuarios en esta categoría.</em>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>


    <partial name="_ModalEliminar" />
</div>
  <div v-if="rolActivo === 'Todos'">
    @if (ViewBag.TotalPaginas > 1)
    {
        int paginaActual = ViewBag.PaginaActual ?? 1;
        int totalPaginas = ViewBag.TotalPaginas ?? 1;

        <nav aria-label="Navegación de páginas" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual - 1)">
                        <i class="bi bi-chevron-left"></i> Anterior
                    </a>
                </li>

                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == paginaActual ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@i">@i</a>
                    </li>
                }

                <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual + 1)">
                        Siguiente <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

    <script>
        const datosUsuarios = @Html.Raw(datosUsuariosJson);

        const { createApp } = Vue;

        createApp({
            data() {
                const rolesUnicos = ['Todos', ...new Set(datosUsuarios.map(u => u.rolNombre))];

                return {
                    usuarios: datosUsuarios,
                    roles: rolesUnicos,
                    rolActivo: 'Todos'
                };
            },
            computed: {
                usuariosFiltrados() {
                    if (this.rolActivo === 'Todos') {
                        return this.usuarios;
                    }
                    return this.usuarios.filter(u => u.rolNombre === this.rolActivo);
                }
            },
            methods: {
                cambiarRol(rol) {
                    this.rolActivo = rol;
                },
                confirmarBaja(usuario) {
                    abrirModalEliminar(usuario.idUsuario, usuario.nombreCompleto, '/Usuario/Baja');
                }
            }
        }).mount('#appUsuarios');
    </script>
}
