@model sistema_gastronomico_pascual_leyes_delahoz_clavero.Models.Usuario

@{
    ViewData["Title"] = "Mi Perfil";

    var avatarVm = new sistema_gastronomico_pascual_leyes_delahoz_clavero.Models.AvatarViewModel
    {
        AvatarPath = Model.AvatarPath,
        Nombre = Model.Empleado?.Nombre,
        Apellido = Model.Empleado?.Apellido,
        Tamanio = 120
    };
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-success">@TempData["Mensaje"]</div>
            }

            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4">
                    <h4 class="card-title mb-4">
                        <i class="bi bi-person-badge me-2"></i>Mi Perfil
                    </h4>

                    <div class="d-flex flex-column align-items-center mb-4">
                        <partial name="_Avatar" model="avatarVm" />

                        <h5 class="mt-3 mb-0">@Model.Empleado?.Nombre @Model.Empleado?.Apellido</h5>
                        <span class="text-muted">@@@Model.Username</span>
                        <span class="badge bg-secondary mt-2">@(Model.Rol?.Nombre ?? "Sin rol")</span>
                    </div>

                    <hr />

                    <dl class="row mb-4">
                        <dt class="col-sm-4">Legajo</dt>
                        <dd class="col-sm-8">@Model.Empleado?.Legajo</dd>

                        <dt class="col-sm-4">DNI</dt>
                        <dd class="col-sm-8">@Model.Empleado?.Dni</dd>

                        <dt class="col-sm-4">Teléfono</dt>
                        <dd class="col-sm-8">@(Model.Empleado?.Telefono ?? "-")</dd>
                    </dl>

                    <hr />

                    <h6 class="text-muted text-uppercase small fw-bold mb-3">Cambiar foto de perfil</h6>

                    <form asp-action="Perfil" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                        <div class="mb-3">
                            <input type="file" name="avatar" class="form-control" accept="image/png, image/jpeg, image/webp" required />
                            <div class="form-text">JPG, PNG o WEBP. Máximo 2 MB.</div>
                        </div>

                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-upload me-1"></i> Guardar foto
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
