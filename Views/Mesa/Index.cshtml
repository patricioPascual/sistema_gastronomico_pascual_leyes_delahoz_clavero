@using sistema_gastronomico_pascual_leyes_delahoz_clavero.Models
@model List<Mesa>
@{
    ViewData["Title"] = "Mesas";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0"><i class="bi bi-table me-2"></i>Mesas</h2>
        <div>
            <a asp-action="Salon" class="btn btn-outline-secondary me-2">
                <i class="bi bi-grid-3x3-gap"></i> Ver salón
            </a>
            <a asp-action="Alta" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Nueva mesa
            </a>
        </div>
    </div>

    <partial name="_Mensajes" />

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Número</th>
                    <th>Tipo</th>
                    <th>Capacidad</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    bool ocupada = m.IdPedidoAbierto.HasValue;
                    <tr>
                        <td>@m.Numero</td>
                        <td>@m.Tipo</td>
                        <td>@m.Capacidad</td>
                        <td>
                            @if (ocupada)
                            {
                                <span class="badge bg-danger">Ocupada</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Libre</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Editar" asp-route-id="@m.IdMesa" class="btn btn-outline-primary btn-sm me-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Baja" asp-route-id="@m.IdMesa" method="post" class="d-inline"
                                onsubmit="return confirm('¿Eliminar la mesa @m.Numero?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No hay mesas cargadas.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>