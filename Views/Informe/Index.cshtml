@{
    ViewData["Title"] = "Informes y Estadísticas";
}

<div class="container-fluid mt-4 mb-5" id="appInformes">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Informes y Estadísticas</h2>
        
        <!-- FECHAS -->
        <div class="d-flex align-items-center gap-2 bg-white p-2 border rounded shadow-sm">
            <label class="form-label mb-0 fw-bold fs-7">Desde:</label>
            <input type="date" class="form-control form-control-sm" v-model="fechaDesde" @@change="cargarInformeActivo">
            
            <label class="form-label mb-0 fw-bold fs-7">Hasta:</label>
            <input type="date" class="form-control form-control-sm" v-model="fechaHasta" @@change="cargarInformeActivo">
            
            <button class="btn btn-sm btn-primary" @@click="cargarInformeActivo">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </div>

    <!-- PESTAÑAS -->
    <ul class="nav nav-tabs nav-fill mb-4" id="pestañasInformes" role="tablist">
        <li class="nav-item">
            <button class="nav-link active fw-bold" @@click="cambiarPestana('balance')">
                <i class="bi bi-cash-stack me-1"></i> Balance General
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-bold" @@click="cambiarPestana('platos')">
                <i class="bi bi-egg-fried me-1"></i> Platos Más Vendidos
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-bold" @@click="cambiarPestana('proveedores')">
                <i class="bi bi-truck me-1"></i> Compras por Proveedor
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-bold" @@click="cambiarPestana('mozos')">
                <i class="bi bi-person-badge me-1"></i> Ventas por Mozo
            </button>
        </li>
    </ul>

    
    <div class="position-relative min-vh-50">
       
        <div v-if="cargando" class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Cargando informe...</p>
        </div>

        <div v-else>
            <!-- BALANCE -->
            <div v-if="pestanaActiva === 'balance'" class="row g-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm bg-success text-white">
                        <div class="card-body">
                            <h6>Total Ventas</h6>
                            <h3 class="mb-0">$ {{ balance.totalVentas ? balance.totalVentas.toFixed(2) : '0.00' }}</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm bg-danger text-white">
                        <div class="card-body">
                            <h6>Total Compras</h6>
                            <h3 class="mb-0">$ {{ balance.totalCompras ? balance.totalCompras.toFixed(2) : '0.00' }}</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm" :class="balance.saldoNeto >= 0 ? 'bg-primary text-white' : 'bg-warning text-dark'">
                        <div class="card-body">
                            <h6>Saldo Neto</h6>
                            <h3 class="mb-0">$ {{ balance.saldoNeto ? balance.saldoNeto.toFixed(2) : '0.00' }}</h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PESTAÑA PLATOS -->
            <div v-if="pestanaActiva === 'platos'" class="table-responsive bg-white rounded shadow-sm p-3">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Plato</th>
                            <th class="text-center">Cantidad Vendida</th>
                            <th class="text-end">Total Recaudado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="item in platos" :key="item.nombrePlato">
                            <td class="fw-bold">{{ item.nombrePlato }}</td>
                            <td class="text-center">{{ item.cantidadVendida }}</td>
                            <td class="text-end text-success fw-bold">$ {{ item.totalRecaudado.toFixed(2) }}</td>
                        </tr>
                        <tr v-if="platos.length === 0">
                            <td colspan="3" class="text-center text-muted">No se encontraron registros en este período.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!--PESTANA PROVVEDOR -->
            <div v-if="pestanaActiva === 'proveedores'" class="table-responsive bg-white rounded shadow-sm p-3">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Proveedor</th>
                            <th class="text-center">Facturas / Compras</th>
                            <th class="text-end">Total Acumulado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="item in proveedores" :key="item.nombreProveedor">
                            <td class="fw-bold">{{ item.nombreProveedor }}</td>
                            <td class="text-center">{{ item.cantidadCompras }}</td>
                            <td class="text-end text-danger fw-bold">$ {{ item.totalAcumulado.toFixed(2) }}</td>
                        </tr>
                        <tr v-if="proveedores.length === 0">
                            <td colspan="3" class="text-center text-muted">No se encontraron compras en este período.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!--VENTAS MOZO-->
            <div v-if="pestanaActiva === 'mozos'" class="table-responsive bg-white rounded shadow-sm p-3">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Mozo / Empleado</th>
                            <th class="text-center">Atenciones / Pedidos</th>
                            <th class="text-end">Total Ventas</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="item in mozos" :key="item.nombreEmpleado">
                            <td class="fw-bold">{{ item.nombreEmpleado }}</td>
                            <td class="text-center">{{ item.cantidadPedidos }}</td>
                            <td class="text-end text-success fw-bold">$ {{ item.totalVentas.toFixed(2) }}</td>
                        </tr>
                        <tr v-if="mozos.length === 0">
                            <td colspan="3" class="text-center text-muted">No hay ventas registradas por mozos en este período.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                // Fechas por defecto: hace 30 días hasta hoy
                const hoy = new Date().toISOString().split('T')[0];
                const haceUnMes = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];

                return {
                    fechaDesde: haceUnMes,
                    fechaHasta: hoy,
                    pestanaActiva: 'balance',
                    cargando: false,

                 
                    balance: {},
                    platos: [],
                    proveedores: [],
                    mozos: []
                };
            },
            methods: {
                cambiarPestana(nombrePestana) {
                    this.pestanaActiva = nombrePestana;
                    
                    
                    const links = document.querySelectorAll('#pestañasInformes .nav-link');
                    links.forEach(el => el.classList.remove('active'));
                    event.currentTarget.classList.add('active');

                    this.cargarInformeActivo();
                },
                cargarInformeActivo() {
                    this.cargando = true;
                    let url = '';

                    switch (this.pestanaActiva) {
                        case 'balance':
                            url = `/Informe/GetBalance?desde=${this.fechaDesde}&hasta=${this.fechaHasta}`;
                            break;
                        case 'platos':
                            url = `/Informe/GetPlatosMasVendidos?desde=${this.fechaDesde}&hasta=${this.fechaHasta}`;
                            break;
                        case 'proveedores':
                            url = `/Informe/GetComprasPorProveedor?desde=${this.fechaDesde}&hasta=${this.fechaHasta}`;
                            break;
                        case 'mozos':
                            url = `/Informe/GetVentasPorMozo?desde=${this.fechaDesde}&hasta=${this.fechaHasta}`;
                            break;
                    }

                    fetch(url)
                        .then(res => res.json())
                        .then(data => {
                            if (this.pestanaActiva === 'balance') this.balance = data;
                            if (this.pestanaActiva === 'platos') this.platos = data;
                            if (this.pestanaActiva === 'proveedores') this.proveedores = data;
                            if (this.pestanaActiva === 'mozos') this.mozos = data;
                        })
                        .catch(err => console.error("Error al cargar informe:", err))
                        .finally(() => {
                            this.cargando = false;
                        });
                }
            },
            mounted() {
                this.cargarInformeActivo();
            }
        }).mount('#appInformes');
    </script>
}