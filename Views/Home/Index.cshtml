@{
    ViewData["Title"] = "Inicio";
}

<div class="container-fluid py-2">
    <div class="row mb-4 align-items-center">
        <div class="col-12">
            <h2 class="fw-bold mb-1">Bienvenido a Foodly</h2>
            <p class="text-muted">Panel principal de gestión gastronómica</p>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 hover-elevate transition-all">
                <div class="card-body p-4 d-flex flex-column align-items-center text-center">
                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-3 mb-3 d-flex align-items-center justify-content-center"
                         style="width: 64px; height: 64px;">
                        <i class="bi bi-grid-3x3-gap fs-2"></i>
                    </div>
                    <h5 class="fw-bold">Salón</h5>
                    <p class="text-muted small flex-grow-1">Gestiona las mesas, la barra y toma nuevos pedidos al
                        instante.</p>
                        <a asp-controller="Mesa" asp-action="Salon"
                           class="btn btn-outline-danger w-100 rounded-pill mt-2">Ir al Salón</a>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 hover-elevate transition-all">
                    <div class="card-body p-4 d-flex flex-column align-items-center text-center">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 mb-3 d-flex align-items-center justify-content-center"
                             style="width: 64px; height: 64px;">
                            <i class="bi bi-egg-fried fs-2"></i>
                        </div>
                        <h5 class="fw-bold">Menú</h5>
                        <p class="text-muted small flex-grow-1">Administra los platos, recetas y precios de venta al
                            público.</p>
                            <a asp-controller="Plato" asp-action="Index"
                               class="btn btn-outline-primary w-100 rounded-pill mt-2">Ver Menú</a>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100 hover-elevate transition-all">
                        <div class="card-body p-4 d-flex flex-column align-items-center text-center">
                            <div class="bg-success bg-opacity-10 text-success rounded-circle p-3 mb-3 d-flex align-items-center justify-content-center"
                                 style="width: 64px; height: 64px;">
                                <i class="bi bi-receipt fs-2"></i>
                            </div>
                            <h5 class="fw-bold">Pedidos</h5>
                            <p class="text-muted small flex-grow-1">Controla los pedidos en curso, facturación y tiempos de
                                espera.</p>
                                <a asp-controller="Pedido" asp-action="Index"
                                   class="btn btn-outline-success w-100 rounded-pill mt-2">Ver Pedidos</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="card border-0 shadow-sm rounded-4 h-100 hover-elevate transition-all">
                            <div class="card-body p-4 d-flex flex-column align-items-center text-center">
                                <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3 mb-3 d-flex align-items-center justify-content-center"
                                     style="width: 64px; height: 64px;">
                                    <i class="bi bi-box-seam fs-2"></i>
                                </div>
                                <h5 class="fw-bold">Inventario</h5>
                                <p class="text-muted small flex-grow-1">Control de insumos, stock disponible y alertas de
                                    reposición.</p>
                                    <a asp-controller="Producto" asp-action="Index"
                                       class="btn btn-outline-warning w-100 rounded-pill mt-2">Ir a Inventario</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
