@model sistema_gastronomico_pascual_leyes_delahoz_clavero.Models.AvatarViewModel

@{
    var iniciales = sistema_gastronomico_pascual_leyes_delahoz_clavero.Helpers.AvatarHelper.ObtenerIniciales(Model.Nombre, Model.Apellido);
    var tieneAvatar = !string.IsNullOrWhiteSpace(Model.AvatarPath);
    var tamanioPx = Model.Tamanio;
}

@if (tieneAvatar)
{
    <img src="@Url.Content(Model.AvatarPath!)"
         alt="Foto de perfil"
         class="rounded-circle object-fit-cover flex-shrink-0"
         style="width: @(tamanioPx)px; height: @(tamanioPx)px;" />
}
else
{
    <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0"
         style="width: @(tamanioPx)px; height: @(tamanioPx)px; font-size: @(tamanioPx * 0.4)px; line-height: 1;">
        @iniciales
    </div>
}
