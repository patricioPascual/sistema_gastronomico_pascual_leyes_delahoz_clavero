@model sistema_gastronomico_pascual_leyes_delahoz_clavero.Models.Producto

@{
    ViewData["Title"] = "Alta de Producto";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-success text-white py-3">
                    <h4 class="card-title mb-0">
                        <i class="bi bi-plus-circle me-2"></i>Cargar Nuevo Insumo / Producto
                    </h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Crear" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        
                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-bold">Nombre del Insumo</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Harina 000, Carne Picada, Tomate" required />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            
                            <div class="col-md-6 mb-3">
                                <label asp-for="Cantidad_stock" class="form-label fw-bold">Stock Inicial</label>
                                <input asp-for="Cantidad_stock" type="number" step="0.001" class="form-control" placeholder="0.000" required />
                                <span asp-validation-for="Cantidad_stock" class="text-danger small"></span>
                            </div>

                           
                            <div class="col-md-6 mb-3">
                                <label asp-for="Unidad_medida" class="form-label fw-bold">Unidad de Medida</label>
                                <select asp-for="Unidad_medida" class="form-select" required>
                                    <option value="" selected disabled>Seleccionar...</option>
                                    <option value="kg">Kilogramos (kg)</option>
                                    <option value="gr">Gramos (gr)</option>
                                    <option value="lt">Litros (lt)</option>
                                    <option value="ml">Mililitros (ml)</option>
                                    <option value="unidad">Unidades (un)</option>
                                    <option value="lata">Lata / Envase</option>
                                </select>
                                <span asp-validation-for="Unidad_medida" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            
                            <div class="col-md-6 mb-3">
                                <label asp-for="Precio_costo" class="form-label fw-bold">Precio de Costo ($)</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Precio_costo" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                                </div>
                                <span asp-validation-for="Precio_costo" class="text-danger small"></span>
                            </div>

                          
                            <div class="col-md-6 mb-3 d-flex align-items-end">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Estado" id="estadoSwitch" checked />
                                    <label class="form-check-label fw-bold" for="estadoSwitch">Producto Activo</label>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                     
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Volver al Listado
                            </a>
                            <button type="submit" class="btn btn-success px-4">
                                <i class="bi bi-check-lg me-1"></i> Guardar Insumo
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}