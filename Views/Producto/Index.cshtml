@model IEnumerable<sistema_gastronomico_pascual_leyes_delahoz_clavero.Models.Producto>

@{
    ViewData["Title"] = "Gestión de Productos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-box-seam"></i> Listado de Insumos / Productos</h2>
        <a asp-action="Crear" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Agregar Nuevo Producto
        </a>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>#ID</th>
                    <th>Nombre</th>
                    <th>Stock</th>
                    <th>Unidad</th>
                    <th>Precio Costo</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.IdProducto</td>
                            <td><strong>@item.Nombre</strong></td>
                            <td>@item.Cantidad_stock</td>
                            <td>@item.Unidad_medida</td>
                            <td>$@item.Precio_costo.ToString("N2")</td>
                            <td>
                                @if (item.Estado)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Editar" asp-route-id="@item.IdProducto" class="btn btn-sm btn-outline-primary me-1" title="Editar">
                                    <i class="bi bi-pencil"></i> Modificar
                                </a>
                                <a asp-action="Eliminar" asp-route-id="@item.IdProducto" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            <em>No hay productos cargados en el sistema.</em>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>