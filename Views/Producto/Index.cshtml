@model IEnumerable<sistema_gastronomico_pascual_leyes_delahoz_clavero.Models.Producto>

@{
    ViewData["Title"] = "Gestión de Productos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-box-seam"></i> Listado de Insumos / Productos</h2>
        <div>
            <a asp-action="Alta" class="btn btn-success me-2">
                <i class="bi bi-plus-lg"></i> Agregar Nuevo Producto
            </a>
            <a asp-controller="Compra" asp-action="Alta" class="btn btn-primary">
                <i class="bi bi-cart-plus"></i> Registrar Compra
            </a>
        </div>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>#ID</th>
                    <th>Nombre</th>
                    <th>Stock</th>
                    <th>Unidad</th>
                    <th>Precio Costo</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.IdProducto</td>
                            <td><strong>@item.Nombre</strong></td>
                            <td>@item.Cantidad_stock</td>
                            <td>@item.Unidad_medida</td>
                            <td>$@item.Precio_costo.ToString("N2")</td>
                            <td>
                                @if (item.Estado)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Modificar" asp-route-id="@item.IdProducto"
                                   class="btn btn-sm btn-outline-primary me-1" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                
                                <button type="button" class="btn btn-sm btn-outline-danger" title="Eliminar"
                                        onclick="abrirModalEliminar(@item.IdProducto, '@item.Nombre', '@Url.Action("Eliminar", "Producto")')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            <em>No hay productos cargados en el sistema.</em>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@if (ViewBag.TotalPaginas > 1)
    {
        int paginaActual = ViewBag.PaginaActual ?? 1;
        int totalPaginas = ViewBag.TotalPaginas ?? 1;

        <nav aria-label="Navegación de páginas" class="mt-4">
            <ul class="pagination justify-content-center">
                
                <!-- Botón Anterior -->
                <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual - 1)">
                        <i class="bi bi-chevron-left"></i> Anterior
                    </a>
                </li>

                <!-- Números de Página -->
                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == paginaActual ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@i">@i</a>
                    </li>
                }

                <!-- Botón Siguiente -->
                <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual + 1)">
                        Siguiente <i class="bi bi-chevron-right"></i>
                    </a>
                </li>

            </ul>
        </nav>
    }

<partial name="_ModalEliminar" />